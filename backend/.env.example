# Local workspace roots
WORKSPACE_ROOT=C:\\Users\\Drew\\Documents\\Jarvis_Context\\Projects\\ai-workspace
WORKSPACE_DB_PATH=C:\\Users\\Drew\\Documents\\Jarvis_Context\\Projects\\ai-workspace\\backend\\workspace.db
WORKSPACE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Model routing. Ollama-installed models are the priority local lane. Nanbeige
# remains an explicit verified baseline; there is no automatic cross-provider fallback.
WORKSPACE_MODEL_PROVIDER=ollama
WORKSPACE_MODEL_TIMEOUT_SECONDS=180

# Shared loopback-only Nanbeige listener (RTX 2070 SUPER / port 8080).
NANBEIGE_BASE_URL=http://127.0.0.1:8080/v1
NANBEIGE_MODEL=nanbeige4.2-3b-local

# Explicit opt-in LiquidAI LFM2.5-2.6B route. This must be a separate local
# OpenAI-compatible runtime; it must never point at the Nanbeige listener.
LFM_BASE_URL=http://127.0.0.1:8082/v1
LFM_MODEL=LFM2.5-2.6B
LFM_TIMEOUT_SECONDS=120

# Priority local model server. Leave OLLAMA_MODEL blank to select the first exact
# ID returned by /api/tags, or set it to one exact installed model name.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# MiniMax-compatible OpenAI endpoint (only used when WORKSPACE_MODEL_PROVIDER=minimax).
# Keep the key in the process environment or a local ignored .env file; never commit it.
MINIMAX_BASE_URL=
MINIMAX_MODEL=MiniMax-M3
MINIMAX_API_KEY=

# Explicit OpenRouter route. The endpoint profile remains disabled until an exact
# model ID is saved in Control Center and this environment alias is configured.
OPENROUTER_API_KEY=

# External feedback publication is fail-closed. Set this to github only when the
# GitHub destination/token are configured and each issue send is explicitly confirmed.
WORKSPACE_FEEDBACK_PUBLISHER=disabled
# GITHUB_REPOSITORY=owner/repository

# Optional Buzz executable override
# BUZZ_EXECUTABLE=C:\\path\\to\\buzz.exe

# Optional allowlisted local agent commands. Commands receive workflow input via stdin.
# WORKSPACE_AGENT_COMMANDS={"hermes":["hermes","..."],"codex":["codex","exec"]}
